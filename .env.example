# Copy to .env.local and fill in. Never commit real values.

# Resend API key for the partner enquiry form (https://resend.com)
RESEND_API_KEY=

# Where enquiries are delivered
CONTACT_TO_EMAIL=

# Sender address on a domain verified in Resend (for example enquiries@playmode.ca)
CONTACT_FROM_EMAIL=

# Public contact address shown in the footer and used for the mailto fallback
NEXT_PUBLIC_CONTACT_EMAIL=

# Canonical site URL, used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://playmode.ca
